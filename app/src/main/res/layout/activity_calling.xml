<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/primary"

    tools:context=".activities.callingAct">


    <!-- ========================================= -->
    <!-- BACK BUTTON -->
    <!-- ========================================= -->

    <ImageView
        android:id="@+id/backFromCalling"

        android:layout_width="32dp"
        android:layout_height="32dp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"

        android:src="@drawable/baseline_arrow_back"

        android:contentDescription="Back"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ========================================= -->
    <!-- PAGE TITLE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/callingTitle"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"

        android:text="Calling"

        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"

        android:gravity="center"

        app:layout_constraintStart_toEndOf="@id/backFromCalling"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/backFromCalling"
        app:layout_constraintBottom_toBottomOf="@id/backFromCalling" />


    <!-- ========================================= -->
    <!-- CALL ICON -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/callIcon"

        android:layout_width="90dp"
        android:layout_height="90dp"

        android:layout_marginTop="80dp"

        android:background="@drawable/background_image"

        android:gravity="center"

        android:text="📞"
        android:textSize="42sp"

        app:layout_constraintTop_toBottomOf="@id/backFromCalling"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================= -->
    <!-- MAIN TITLE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/textView5"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="25dp"

        android:text="Let's Start Calling"

        android:textColor="@color/white"

        android:textSize="27sp"

        android:textStyle="bold"

        android:gravity="center"

        app:layout_constraintTop_toBottomOf="@id/callIcon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================= -->
    <!-- SUBTITLE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/textView6"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="10dp"

        android:text="Enter Unique ID to start a call"

        android:textColor="#CCCCCC"

        android:textSize="15sp"

        app:layout_constraintTop_toBottomOf="@id/textView5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================= -->
    <!-- CALL INSTRUCTION -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/callInstruction"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginStart="30dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="30dp"

        android:text="💡 Both users must enter the same Unique ID to connect the call."

        android:textColor="#E0E0E0"

        android:textSize="13sp"

        android:gravity="center"

        android:lineSpacingExtra="2dp"

        app:layout_constraintTop_toBottomOf="@id/textView6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================================= -->
    <!-- UNIQUE ID INPUT -->
    <!-- ========================================= -->

    <androidx.cardview.widget.CardView

        android:id="@+id/userIdCard"

        android:layout_width="0dp"
        android:layout_height="56dp"

        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"

        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"

        app:layout_constraintTop_toBottomOf="@id/callInstruction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <EditText
            android:id="@+id/getUserId"

            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:background="@null"

            android:hint="Enter Unique ID"

            android:paddingStart="18dp"
            android:paddingEnd="18dp"

            android:singleLine="true"

            android:imeOptions="actionDone"

            android:importantForAutofill="no"

            android:inputType="text"

            android:textColor="@color/primary_text"

            android:textColorHint="#888888"

            android:textSize="14sp" />

    </androidx.cardview.widget.CardView>


    <!-- ========================================= -->
    <!-- START CALL BUTTON -->
    <!-- ========================================= -->

    <Button
        android:id="@+id/button2"

        android:layout_width="0dp"
        android:layout_height="54dp"

        android:layout_marginStart="25dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"

        android:text="📞  START CALL"

        android:textSize="15sp"
        android:textStyle="bold"

        android:textColor="@color/white"

        android:backgroundTint="@color/primary"

        app:cornerRadius="27dp"

        app:layout_constraintTop_toBottomOf="@id/userIdCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>