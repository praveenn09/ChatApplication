<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/primary"

    tools:context=".activities.useradd">


    <!-- ================================================= -->
    <!-- CURRENT USER PROFILE -->
    <!-- ================================================= -->

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/userprofile"

        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"

        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"

        android:background="@drawable/background_image"
        android:src="@drawable/ic_dummy_user"

        android:contentDescription="Profile"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================================================= -->
    <!-- CURRENT USER NAME -->
    <!-- ================================================= -->

    <TextView
        android:id="@+id/setUserName"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="24dp"

        android:text="Praveen"

        android:textColor="@color/white"
        android:textSize="@dimen/_14sdp"
        android:textStyle="bold"

        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================================================= -->
    <!-- LOGOUT -->
    <!-- ================================================= -->

    <ImageView
        android:id="@+id/logoutbutton"

        android:layout_width="28dp"
        android:layout_height="28dp"

        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"

        android:src="@drawable/baseline_logout"

        android:contentDescription="Logout"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatContainer"

        android:layout_width="match_parent"
        android:layout_height="0dp"

        android:layout_marginTop="@dimen/_16sdp"

        android:background="@drawable/background_content"

        app:layout_constraintTop_toBottomOf="@id/userprofile"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================================================= -->
        <!-- CHAT REQUEST SECTION -->
        <!-- ================================================= -->

        <LinearLayout
            android:id="@+id/requestSection"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"

            android:visibility="gone"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <!-- Request title -->

            <TextView
                android:id="@+id/requestTitle"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="🔔  Chat Requests"

                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold"

                android:paddingStart="4dp"
                android:paddingBottom="6dp" />


            <!-- Request RecyclerView -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/requestRecyclerView"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"

                android:clipToPadding="false" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- CHAT LIST -->
        <!-- ================================================= -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"

            android:layout_width="match_parent"
            android:layout_height="0dp"

            android:clipToPadding="false"

            android:paddingTop="8dp"
            android:paddingBottom="85dp"

            android:overScrollMode="never"

            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"

            app:layout_constraintTop_toBottomOf="@id/requestSection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <!-- ================================================= -->
        <!-- ADD USER BUTTON -->
        <!-- ================================================= -->

        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/addbutton"

            android:layout_width="@dimen/_45sdp"
            android:layout_height="@dimen/_45sdp"

            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"

            android:background="@drawable/background_image"
            android:backgroundTint="@color/primary"

            android:src="@drawable/baseline_add"

            android:scaleType="center"

            android:elevation="8dp"

            android:contentDescription="Add user"

            app:riv_oval="true"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>